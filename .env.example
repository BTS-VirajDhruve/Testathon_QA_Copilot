# Copy to .env at the repository root OR backend/.env
# Settings load from the process working directory (run commands from backend/).

# OpenAI (optional — demo fallback works without a key)
OPENAI_API_KEY=
# Global default / final chat fallback when task routing is off or a task model is unavailable
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Task-aware model routing (optional overrides; empty = built-in map) ---
# Built-in defaults (when routing enabled):
#   intent_classification / qa_documentation / regression_selection / graph_extraction /
#   output_repair / critic_notes  → gpt-5.4-mini
#   bug_report / test_case_generation / targeted_test_generation /
#   test_review_automation → gpt-5.6-luna
#   exploratory_scenario → gpt-5.6-sol
#   reviewer_pass → gpt-5.6-terra
OPENAI_MODEL_INTENT_CLASSIFICATION=
OPENAI_MODEL_QA_DOCUMENTATION=
OPENAI_MODEL_REGRESSION_SELECTION=
OPENAI_MODEL_BUG_REPORT=
OPENAI_MODEL_TEST_CASE_GENERATION=
OPENAI_MODEL_TARGETED_TEST_GENERATION=
OPENAI_MODEL_EXPLORATORY_SCENARIO=
OPENAI_MODEL_REVIEWER_PASS=
OPENAI_MODEL_GRAPH_EXTRACTION=
OPENAI_MODEL_ENTITY_EXTRACTION=
OPENAI_MODEL_OUTPUT_REPAIR=
OPENAI_MODEL_CRITIC_NOTES=
OPENAI_MODEL_TEST_REVIEW_AUTOMATION=
OPENAI_MODEL_TEST_VALIDITY_REVIEW=
OPENAI_MODEL_AUTOMATION_FEASIBILITY_REVIEW=
OPENAI_MODEL_BDD_EXPORT_CONVERSION=
OPENAI_MODEL_ESCALATION_TARGET=

# Feature flags
MODEL_ROUTING_ENABLED=true
MODEL_ESCALATION_ENABLED=true
# Expensive high-tier reviewer — off by default (CriticAgent still runs)
MODEL_REVIEWER_ENABLED=false
MODEL_ROUTING_LOG_ENABLED=true
# Comma list of task types, or * / all for every task
MODEL_ROUTING_ENABLED_TASKS=*

# BDD export
BDD_EXPORT_MAX_BACKGROUND_STEPS=4

# Test generation volume + silent coverage-closure refinement
TEST_GENERATION_MIN_CASES=25
TEST_GENERATION_MAX_PER_GAP=3
TEST_GENERATION_MAX_GAPS_PER_ROUND=8
TEST_GENERATION_MAX_REGENERATION_ROUNDS=2
TEST_REFINEMENT_ENABLED=true
TEST_REFINEMENT_MAX_ITERATIONS=6
TEST_REFINEMENT_MAX_TESTS=250
TEST_REFINEMENT_REQUIRE_ZERO_NEEDS_REVISION=true

MODEL_ESCALATE_ON_SECURITY=true
MODEL_ESCALATE_ON_RELEASE_BLOCKING=true
MODEL_ESCALATE_ON_FINANCIAL=true
MODEL_ESCALATE_ON_VALIDATION_FAILURE=true
MODEL_ESCALATE_ON_AMBIGUITY=true

# Neo4j (optional — falls back to durable JSON graph store)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_ENABLED=false

# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence (relative to backend/ when started from backend/)
DATA_DIR=./data
CHROMA_DIR=./data/chroma
GRAPH_STORE_PATH=./data/graph_store.json

ENABLE_DEMO_FALLBACK=true
LOG_LEVEL=INFO

# Atlassian Cloud (Jira + Confluence) — OAuth 2.0 3LO (backend-only secrets)
ATLASSIAN_INTEGRATION_ENABLED=true
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/atlassian/callback
ATLASSIAN_OAUTH_SCOPES=read:jira-work read:space:confluence read:page:confluence offline_access
ATLASSIAN_TOKEN_ENCRYPTION_KEY=
ATLASSIAN_REQUEST_TIMEOUT_SECONDS=30
ATLASSIAN_MAX_RETRIES=3
ATLASSIAN_DEFAULT_PAGE_SIZE=50
ATLASSIAN_IMPORT_MAX_ITEMS=200
ATLASSIAN_COMMENTS_IMPORT_ENABLED=false
ATLASSIAN_ATTACHMENTS_IMPORT_ENABLED=false
ATLASSIAN_FRONTEND_BASE_URL=http://localhost:3000

# Frontend (set when running the UI; not read by the backend)
# NEXT_PUBLIC_API_URL=http://localhost:8000
