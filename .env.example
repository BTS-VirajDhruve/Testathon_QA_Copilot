# Copy to .env at the repository root OR backend/.env
# Settings load from the process working directory (run commands from backend/).

# OpenAI (optional — demo fallback works without a key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Neo4j (optional — falls back to durable JSON graph store)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_ENABLED=false

# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence (relative to backend/ when started from backend/)
DATA_DIR=./data
CHROMA_DIR=./data/chroma
GRAPH_STORE_PATH=./data/graph_store.json

ENABLE_DEMO_FALLBACK=true
LOG_LEVEL=INFO